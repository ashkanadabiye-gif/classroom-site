# Copy these values into your hosting provider's environment settings.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=1

# Optional: enable Redis for multi-process Channels deployments.
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional: configure STUN/TURN for WebRTC connectivity.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]

MAX_UPLOAD_MB=25
MAX_RECORDING_MB=500
KICK_BLOCK_MINUTES=15
